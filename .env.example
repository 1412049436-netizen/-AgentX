# AgentX 环境变量配置
# 复制此文件为 .env 并修改配置

# ===== LLM 提供商 (ollama / deepseek / qwen / openai) =====
# 默认使用 Ollama 本地部署，完全离线可用
LLM_PROVIDER=ollama

# ===== Ollama 本地模型（私有化部署首选）=====
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ===== DeepSeek（云端，需联网）=====
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-your-key-here

# ===== 通义千问（云端，需联网）=====
# LLM_PROVIDER=qwen
# QWEN_API_KEY=sk-your-key-here

# ===== OpenAI（云端，需联网）=====
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here

# ===== 服务配置 =====
AGENTX_PORT=8001
LOG_LEVEL=INFO

# ===== RAG 知识库路径（可选）=====
# RAG_PATH=/data/rag
